---
// Top of every inner page: optional "~/path" eyebrow, big title, intro text.
interface Props {
    title: string;
    eyebrow?: string;
}

const { title, eyebrow } = Astro.props;
---

<header class="page-header">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {Astro.slots.has('default') && <p class="lead"><slot /></p>}
</header>

<style>
    .page-header {
        display: flex;
        flex-direction: column;
        gap: 18px;
        padding-top: 72px;
    }

    .eyebrow {
        margin: 0 0 -4px;
        font-family: var(--font-jetbrains-mono);
        font-size: 13px;
        color: var(--accent);
    }

    h1 {
        margin: 0;
        font-size: clamp(2.2rem, 8vw, 46px);
        font-weight: 700;
        line-height: 1.08;
        letter-spacing: -1.5px;
    }

    .lead {
        margin: 0;
        max-width: 690px;
        font-size: 18px;
        line-height: 1.6;
        color: var(--muted);
    }

    @media (max-width: 640px) {
        .page-header {
            padding-top: 48px;
        }

        .lead {
            font-size: 16px;
        }
    }
</style>
