---
import type { CollectionEntry } from 'astro:content';
import KindLabel from './KindLabel.astro';
import { readingTime } from '../utils/readingTime';

interface Props { post: CollectionEntry<'blog'>; }
const { post } = Astro.props;
const { title, description, date, kind } = post.data;

const minutes = readingTime(post.body);

const shortDate = date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
---

<li class="post" data-kind={kind} data-search={`${title} ${description}`.toLowerCase()}>
  <a href={`/blog/${post.id}`}>
    <div class="meta">
      <KindLabel kind={kind} />
      <span><time datetime={date.toISOString()}>{shortDate}</time> · {minutes} min</span>
    </div>
    <h3>{title}</h3>
    <p>{description}</p>
  </a>
</li>

<style>
  .post {
    border-bottom: 1px solid var(--border);
  }

  a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 20px 0;
    text-decoration: none;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-jetbrains-mono);
    font-size: 12px;
    color: var(--dim);
  }

  h3 {
    margin: 2px 0 0;
    font-size: 17px;
    font-weight: 600;
    color: var(--text);
    transition: color .15s;
  }

  a:hover h3 {
    color: var(--accent);
  }

  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: 4px;
  }

  p {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--muted);
  }
</style>

