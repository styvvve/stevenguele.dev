---
import Button from './Button.astro'; 
import { CV_URL, GITHUB_URL, LINKEDIN_URL, EMAIL } from '../data/site';
---

<section class="hero container">
    <p class="status"><span class="dot" aria-hidden="true"></span>Seeking a 24-month apprenticeship • Full-stack / Data / AI</p>

    <h1>Steve NGUELE</h1>

    <p class="lead">
        Between software engineering and artificial intelligence, I design solutions that combine 
        backend architecture, data processing and intelligent automation.
        <br />
        I'm currently pursuing a Master's degree at Epitech Bordeaux. I mainly work with Java / Spring Boot & Node.js for my backend. 
        I'm exploring machine learning, with Python, LLMs and agentic architectures. 
        <br />
        Curious about complex systems and their possibilities, I'm always looking to learn, experiment and build.
    </p>

    <div class="actions">
        <Button variant="primary" href={CV_URL} download>Download my CV</Button>
        <Button variant="ghost" href={`mailto:${EMAIL}`}>Get in touch →</Button>
    </div>

    <ul class="socials"> 
        <li><a href={GITHUB_URL} target="_blank" rel="noopener">github</a></li>
        <li><a href={LINKEDIN_URL} target="_blank" rel="noopener">linkedin</a></li>
        <li><a href={`mailto:${EMAIL}`}>email</a></li>
    </ul>
</section>

<style>
    .lead {
        font-size: 18px; 
        line-height: 1.6; 
        color: var(--muted); 
        max-width: 620px;
        margin: 0; 
    }

    .hero {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 24px; 
        padding: 96px 0 72px; 
    }

    .status {
        display: inline-flex; 
        align-items: center;
        gap: 10px; 
        padding: 7px 14px;
        background: var(--surface);
        border: 1px solid var(--border); 
        border-radius: 999px; 
        font-family: var(--font-jetbrains-mono); 
        font-size: 12.5px; 
        color: var(--text); 
        margin: 0;
    }

    .dot {
        width: 8px; 
        height: 8px; 
        border-radius: 50%; 
        background: var(--ok); 
        box-shadow: 0 0 0 4px rgb(74 222 128 / .15);
    }

    h1 {
        font-size: 52px; 
        font-weight: 700; 
        line-height: 1.08;
        letter-spacing: -1.5px;
        margin: 0; 
    }

    .accent {
        color: var(--accent); 
    }

    .lead strong {
        color: var(--text); 
        font-weight: 400; 
    }

    .actions {
        display: flex; 
        gap: 12px; 
        flex-wrap: wrap; 
    }

    .socials {
        display: flex; 
        gap: 12px; 
        list-style: none; 
        padding: 0;
        margin: 0; 
        font-family: var(--font-jetbrains-mono); 
        font-size: 13px; 
    }

    .socials a {
        color: var(--muted); 
        text-decoration: none;
    }

    .socials a:hover {
        color: var(--text); 
    }

    li + li::before {
        content: "/"; 
        color: var(--dim); 
        margin-right: 12px; 
    }
</style>