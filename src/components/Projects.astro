---
import ProjectCard  from "./ProjectCard.astro";
import Section from "./Section.astro";
import { projects } from "../data/projects"; 
---

<Section num={1} title="Projects" href="/projects" linkLabel="All projects →">
  <ul class="list">
      {projects.map((p) => <li><ProjectCard {...p} /></li>)}
  </ul>
</Section>

<style>
    .list { 
        display: flex;
        flex-direction: column;
        gap: 14px; 
        list-style: none; 
        padding: 0; 
        margin: 0;
    }
</style>
