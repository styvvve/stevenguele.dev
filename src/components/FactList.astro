---
// Bordered card split into equal columns of label/value pairs.
// Used by Facts (home page) and Languages (about page).
interface Props {
    items: { label: string; value: string }[];
}

const { items } = Astro.props;
---

<dl class="facts">
    {items.map((item) => (
        <div class="fact">
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
        </div>
    ))}
</dl>

<style>
    .facts {
        display: flex;
        margin: 0;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
    }

    .fact {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 6px;
        padding: 18px 20px;
    }

    .fact + .fact {
        border-left: 1px solid var(--border);
    }

    dt {
        font-family: var(--font-jetbrains-mono);
        font-size: 11.5px;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: var(--dim);
    }

    dd {
        margin: 0;
        font-size: 15px;
        font-weight: 500;
        color: var(--text);
    }

    @media (max-width: 640px) {
        .facts { flex-direction: column; }
        .fact + .fact { border-left: none; border-top: 1px solid var(--border); }
    }
</style>
