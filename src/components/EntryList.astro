---
// Card listing dated entries (education, experience): period on the left, details on the right.
interface Props {
    entries: { period: string; title: string; detail?: string }[];
}

const { entries } = Astro.props;
---

<ol class="entries">
    {entries.map((entry) => (
        <li class="entry">
            <span class="period">{entry.period}</span>
            <div>
                <h3>{entry.title}</h3>
                {entry.detail && <p>{entry.detail}</p>}
            </div>
        </li>
    ))}
</ol>

<style>
    .entries {
        margin: 0;
        padding: 0 24px;
        list-style: none;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
    }

    .entry {
        display: grid;
        grid-template-columns: 130px minmax(0, 1fr);
        gap: 16px;
        padding: 22px 0;
    }

    .entry + .entry {
        border-top: 1px solid var(--border);
    }

    .period {
        padding-top: 2px;
        font-family: var(--font-jetbrains-mono);
        font-size: 12px;
        color: var(--accent);
    }

    h3 {
        margin: 0;
        font-size: 15px;
        font-weight: 500;
        line-height: 1.4;
    }

    p {
        margin: 6px 0 0;
        font-size: 14px;
        line-height: 1.5;
        color: var(--muted);
    }

    @media (max-width: 640px) {
        .entries {
            padding: 0 20px;
        }

        .entry {
            grid-template-columns: minmax(0, 1fr);
            gap: 6px;
            padding: 18px 0;
        }
    }
</style>
